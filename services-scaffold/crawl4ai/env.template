###############################################
# Crawl4AI Configuration
# Generated from services-scaffold/crawl4ai/env.template
###############################################

# Container settings
CRAWL4AI_DOCKER_TAG=${CRAWL4AI_DOCKER_TAG:-latest}
CRAWL4AI_CONTAINER_NAME=${CRAWL4AI_CONTAINER_NAME:-crawl4ai}
CRAWL4AI_RESTART=${CRAWL4AI_RESTART:-unless-stopped}

# Security: API auth is on by default in v0.9.x (server binds loopback
# without a token). Generate one, e.g.:
#   openssl rand -hex 32
CRAWL4AI_API_TOKEN=${CRAWL4AI_API_TOKEN:-change-me}

# GPU acceleration requires an image built with ENABLE_GPU=true
# (build arg, not a runtime env var); pick such a tag via CRAWL4AI_DOCKER_TAG.

# Network / routing
CRAWL4AI_HOST_NAME=${CRAWL4AI_HOST_NAME:-crawl4ai}
CRAWL4AI_TRAEFIK_ENABLE=${CRAWL4AI_TRAEFIK_ENABLE:-true}
CRAWL4AI_WATCHTOWER_ENABLE=${CRAWL4AI_WATCHTOWER_ENABLE:-true}
CRAWL4AI_AUTOHEAL=${CRAWL4AI_AUTOHEAL:-true}
